{
  "name": "gestao-servicos",
  "productName": "Gestão de Serviços",
  "version": "1.0.3",
  "description": "Sistema local de produção e gestão financeira.",
  "author": "Gustavo Dums",
  "private": true,
  "main": "main.cjs",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "preparar": "npm --prefix ../frontend run build -- --outDir ../desktop/runtime/frontend --emptyOutDir && node scripts/preparar.cjs",
    "prestart": "npm run preparar",
    "start": "electron-forge start",
    "premake": "npm run preparar",
    "make": "node scripts/empacotar.cjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@embedded-postgres/windows-x64": "16.16.0-beta.19",
    "electron": "45.5.0"
  }
}
